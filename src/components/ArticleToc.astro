---
interface Heading { depth: number; slug: string; text: string; }
interface Props { headings: Heading[]; }
const headings = Astro.props.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
{headings.length > 0 && (
  <aside class="article-toc">
    <nav class="article-toc__desktop" aria-label="文章目录">
      <p class="article-toc__title">目录</p>
      <ol>
        {headings.map((heading) => (
          <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
        ))}
      </ol>
    </nav>
    <details class="article-toc__mobile">
      <summary>文章目录 · {headings.length} 节</summary>
      <nav class="article-toc__scroll" aria-label="文章目录，可独立滚动" tabindex="0">
        <ol>
          {headings.map((heading) => (
            <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </nav>
    </details>
  </aside>
)}
<script>
  const desktopLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".article-toc__desktop a"));
  const targets = desktopLinks.map((link) => ({
    link, target: document.getElementById(decodeURIComponent(link.hash.slice(1)))
  })).filter((entry): entry is { link: HTMLAnchorElement; target: HTMLElement } => Boolean(entry.target));

  let scheduled = false;
  const updateActiveHeading = () => {
    scheduled = false;
    const current = [...targets].reverse().find(({ target }) => target.getBoundingClientRect().top <= 150);
    desktopLinks.forEach((link) => link.removeAttribute("aria-current"));
    current?.link.setAttribute("aria-current", "location");
  };
  window.addEventListener("scroll", () => {
    if (!scheduled) { scheduled = true; requestAnimationFrame(updateActiveHeading); }
  }, { passive: true });
  window.addEventListener("hashchange", updateActiveHeading);
  updateActiveHeading();

  document.querySelectorAll<HTMLAnchorElement>(".article-toc__mobile a").forEach((link) => {
    link.addEventListener("click", () => {
      const details = link.closest("details");
      if (details) details.open = false;
      const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      if (target) {
        target.setAttribute("tabindex", "-1");
        requestAnimationFrame(() => target.focus({ preventScroll: true }));
      }
    });
  });
</script>
