<div class="reading-progress" aria-hidden="true">
  <span class="reading-progress__bar"></span>
</div>
<script>
  const bar = document.querySelector<HTMLElement>(".reading-progress__bar");
  const article = document.querySelector<HTMLElement>(".article-content");
  const update = () => {
    if (!bar || !article) return;
    const start = article.offsetTop;
    const end = start + article.offsetHeight - window.innerHeight;
    const ratio = end <= start ? 1 : Math.min(1, Math.max(0, (window.scrollY - start) / (end - start)));
    bar.style.width = `${ratio * 100}%`;
  };
  update();
  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update, { passive: true });
</script>
