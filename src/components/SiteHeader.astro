---
interface Props { isHome?: boolean; }
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "文章", active: path === "/" || path.startsWith("/posts") || path.startsWith("/tags") },
  { href: "/series.html", label: "专题", active: path.startsWith("/series") },
  { href: "/archive.html", label: "归档", active: path.startsWith("/archive") },
  { href: "/about.html", label: "关于", active: path.startsWith("/about") },
];
---
<a class="skip-link" href="#main-content">跳到正文</a>
<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-title" href="/" aria-label="Ash's Blog 首页">Ash's Blog<span class="site-title__note">思考笔记</span></a>
    <nav class="site-nav" aria-label="主导航">
      {nav.map((item) => <a href={item.href} aria-current={item.active ? "page" : undefined}>{item.label}</a>)}
    </nav>
  </div>
</header>
