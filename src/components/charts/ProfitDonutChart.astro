---
import { PROFIT_CHARTS, PROFIT_PALETTE } from "../../data/profit-chart";
---
<figure class="profit-figure" data-profit-chart>
  <div class="profit-figure__heading">
    <p>计算层利润分布</p>
    <h3>上游垄断方拿走了最大的一块</h3>
  </div>
  <div class="profit-figure__actions">
    <button type="button" aria-pressed="false">显示房地产结构参照</button>
  </div>
  <div class="profit-figure__charts">
    {PROFIT_CHARTS.map((chart, chartIndex) => (
      <div class="profit-figure__chart" data-reference={chartIndex === 1 ? "" : undefined} hidden={chartIndex === 1}>
        <h4>{chart.title}</h4>
        <div class="profit-donut">
          <svg viewBox="0 0 260 240" role="img" aria-label={`${chart.title}利润分布环形图，分类比重见下方图例`}></svg>
          <div class="profit-donut__center" aria-hidden="true"><span>100%</span><span>利润池</span></div>
        </div>
        <ul class="profit-legend" aria-label={`${chart.title}利润占比`}>
          {chart.values.map((item, itemIndex) => (
            <li><span class="profit-legend__swatch" style={`background:${PROFIT_PALETTE[itemIndex]}`} aria-hidden="true"></span><span>{item.name}</span><span class="profit-legend__value">{item.value}%</span></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <figcaption>比例为结构化示意，用于帮助理解文章里的“卖地者”类比。</figcaption>
  <noscript><p class="profit-figure__fallback">静态说明：AI 计算层的利润大头集中在 GPU 与关键芯片，其次为云服务，服务器组装和数据中心运营所占较小。各项比例见上方图例。</p></noscript>
</figure>

<script>
  import * as d3 from "d3";
  import { PROFIT_CHARTS, PROFIT_PALETTE } from "../../data/profit-chart";

  document.querySelectorAll<HTMLElement>("[data-profit-chart]:not([data-ready])").forEach((root) => {
    root.dataset.ready = "true";
    root.querySelectorAll<SVGSVGElement>("svg").forEach((element, index) => {
      const svg = d3.select(element);
      const group = svg.append("g").attr("transform", "translate(130,120)");
      const arc = d3.arc<d3.PieArcDatum<(typeof PROFIT_CHARTS)[number]["values"][number]>>().innerRadius(58).outerRadius(92);
      const pie = d3.pie<(typeof PROFIT_CHARTS)[number]["values"][number]>().sort(null).value((item) => item.value);
      const arcs = pie(PROFIT_CHARTS[index].values);
      group.selectAll("path").data(arcs).join("path")
        .attr("d", arc)
        .attr("fill", (_, itemIndex) => PROFIT_PALETTE[itemIndex])
        .attr("stroke", "#faf9f5")
        .attr("stroke-width", 2);
    });

    const button = root.querySelector<HTMLButtonElement>("button");
    const reference = root.querySelector<HTMLElement>("[data-reference]");
    button?.addEventListener("click", () => {
      if (!reference) return;
      const show = reference.hidden;
      reference.hidden = !show;
      button.setAttribute("aria-pressed", String(show));
      button.textContent = show ? "隐藏房地产结构参照" : "显示房地产结构参照";
    });
  });
</script>

<style>
  .profit-figure { margin: 2.5rem 0; padding: 1.25rem; border: 0; border-radius: 8px; background: var(--surface); }
  .profit-figure__heading { text-align: center; }
  .profit-figure__heading p { margin: 0; color: var(--accent); font: 500 .75rem var(--sans); letter-spacing: .12em; text-transform: uppercase; }
  .profit-figure__heading h3 { margin: .2rem 0 .65rem; font-size: 1.125rem; }
  .profit-figure__actions { text-align: center; }
  button { border: 1px solid var(--border); background: var(--paper-deep); border-radius: 4px; min-height: 44px; color: var(--ink); padding: .48rem .75rem; font: 500 .875rem var(--sans); cursor: pointer; }
  button[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); }
  .profit-figure__charts { display: flex; justify-content: center; flex-wrap: wrap; gap: 1rem; margin-top: .7rem; }
  .profit-figure__chart { flex: 1 1 280px; min-width: 0; max-width: 360px; }
  .profit-figure__chart h4 { margin: .4rem 0 0; text-align: center; font: 500 .875rem var(--sans); }
  .profit-donut { position: relative; width: min(100%, 280px); margin-inline: auto; }
  svg { display: block; width: 100%; height: auto; }
  .profit-donut__center { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 3px; pointer-events: none; }
  .profit-donut__center span:first-child { color: var(--ink); font-size: 22px; line-height: 1.2; }
  .profit-donut__center span:last-child { color: var(--ink-soft); font-size: 12px; line-height: 1.4; }
  .profit-legend { list-style: none; margin: 0 auto 1.25rem; padding: 0; max-width: 320px; color: var(--ink-soft); font-size: 14px; line-height: 1.6; }
  .profit-legend li { display: grid; grid-template-columns: 10px minmax(0, 1fr) auto; gap: 10px; align-items: baseline; margin: 0; padding: 5px 0; }
  .profit-legend__swatch { width: 10px; height: 10px; }
  .profit-legend__value { color: var(--ink-secondary); font-variant-numeric: tabular-nums; }
  figcaption, .profit-figure__fallback { margin: .5rem 0 0; text-align: center; color: var(--ink-soft); font-size: .875rem; }
</style>
