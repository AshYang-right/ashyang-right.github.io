---
import type { BlogPost } from "../lib/content";
import { formatDate, postUrl, tagSlug } from "../lib/content";
import { SERIES, isSeriesSlug } from "../data/series";
import BaseLayout from "./BaseLayout.astro";
import ArticleToc from "../components/ArticleToc.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
interface Heading { depth: number; slug: string; text: string; }
interface Props { post: BlogPost; headings: Heading[]; previous?: BlogPost; next?: BlogPost; }
const { post, headings, previous, next } = Astro.props;
const { data } = post;
const series = data.series && isSeriesSlug(data.series) ? SERIES[data.series] : undefined;
---
<BaseLayout title={data.title} description={data.description} canonicalPath={postUrl(post)} type="article" publishedAt={data.publishedAt} updatedAt={data.updatedAt}>
  <ReadingProgress />
  <main id="main-content" class="article-shell">
    <header class="article-header">
      <a class="article-back" href="/">← 全部文章</a>
      <div class="article-publication"><span>Ash</span><time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time></div>
      <h1>{data.title}</h1>
      <p class="article-header__description">{data.description}</p>
      <div class="article-tags" aria-label="文章标签">{data.tags.map((tag) => <a href={`/tags/${tagSlug(tag)}.html`}>{tag}</a>)}</div>
      {series && <p class="article-series">收录于 <a href={`/series/${data.series}.html`}>{series.title}</a> · 第 {data.seriesOrder} 篇</p>}
    </header>
    <ArticleToc headings={headings} />
    <article class="article-content"><slot /></article>
    <footer class="article-end">
      <p class="article-colophon">写到这里。<span>发布于 {formatDate(data.publishedAt)}{data.updatedAt ? `，更新于 ${formatDate(data.updatedAt)}` : ""}。</span></p>
      {(previous || next) && <nav class="article-nav" aria-label="文章前后篇">
        {previous ? <a href={postUrl(previous)}><span class="article-nav__label">← 上一篇</span><strong>{previous.data.title}</strong></a> : <span></span>}
        {next && <a href={postUrl(next)}><span class="article-nav__label">下一篇 →</span><strong>{next.data.title}</strong></a>}
      </nav>}
      <a class="text-link article-return" href="/">返回文章列表 ↑</a>
    </footer>
  </main>
</BaseLayout>
