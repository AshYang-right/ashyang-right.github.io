---
import BaseLayout from "../layouts/BaseLayout.astro";
import { allTags, getVisiblePosts, postUrl, tagSlug } from "../lib/content";
const posts = await getVisiblePosts();
const tags = allTags(posts);
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---
<BaseLayout title="Ash's Blog" description="写下来是最好的思考方式。关于 AI、系统、产品与那些值得反复琢磨的问题。" canonicalPath="/">
  <main id="main-content" class="home-index shell">
    <header class="home-intro">
      <h1>写下来，<br />是最好的思考方式。</h1>
      <div class="home-intro__note">
        <p>关于 AI、系统设计与虚拟世界，<br class="desktop-break" />以及那些值得反复琢磨的问题。</p>
        <a class="text-link" href="/about.html">认识 Ash <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <section class="index-section" aria-labelledby="essays-heading">
      <div class="section-heading">
        <h2 id="essays-heading">文章 <span class="section-count">{String(posts.length).padStart(2, "0")}</span></h2>
        <a href="/archive.html">按时间归档 <span aria-hidden="true">↗</span></a>
      </div>
      <nav class="tag-filter" aria-label="按标签筛选文章">
        <button class="tag-filter__button is-active" type="button" data-tag="" aria-pressed="true">全部</button>
        {tags.map(({ tag }) => <button class="tag-filter__button" type="button" data-tag={tag} aria-pressed="false">{tag}</button>)}
      </nav>
      <p class="filter-status sr-only" role="status" aria-live="polite">共 {posts.length} 篇文章</p>
      <div class="posts-list">
        {posts.map((post) => (
          <article class="post-card" data-tags={JSON.stringify(post.data.tags)}>
            <div class="post-card__meta">
              <time class="post-card__date" datetime={isoDate(post.data.publishedAt)}>{isoDate(post.data.publishedAt).replaceAll("-", ".")}</time>
              <span>{post.data.tags[0]}</span>
            </div>
            <div class="post-card__body">
              <h2 class="post-card__title"><a href={postUrl(post)}>{post.data.title}</a></h2>
              <p class="post-card__summary">{post.data.description}</p>
              <div class="post-card__tags" aria-label="文章标签">
                {post.data.tags.map((tag) => <a href={`/tags/${tagSlug(tag)}.html`}>{tag}</a>)}
              </div>
            </div>
            <a class="post-card__arrow" href={postUrl(post)} aria-label={`阅读：${post.data.title}`} tabindex="-1" aria-hidden="true">↗</a>
          </article>
        ))}
        <p class="posts-empty" hidden>该标签下暂无文章。<button type="button" data-reset-filter>查看全部文章</button></p>
      </div>
      <div class="index-end"><p>观点会继续修订，文章地址保持不变。</p><a href="/rss.xml">用 RSS 慢慢读 <span aria-hidden="true">↗</span></a></div>
    </section>
  </main>
  <script>
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".tag-filter__button"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>(".post-card"));
    const empty = document.querySelector<HTMLElement>(".posts-empty");
    const status = document.querySelector<HTMLElement>(".filter-status");
    function filterPosts(tag: string) {
      const activeTag = buttons.some((button) => button.dataset.tag === tag) ? tag : "";
      buttons.forEach((button) => {
        const active = button.dataset.tag === activeTag;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      let visible = 0;
      cards.forEach((card) => {
        const tags = JSON.parse(card.dataset.tags ?? "[]") as string[];
        card.hidden = Boolean(activeTag && !tags.includes(activeTag));
        if (!card.hidden) visible += 1;
      });
      if (empty) empty.hidden = visible !== 0;
      if (status) status.textContent = `${activeTag || "全部"}：${visible} 篇文章`;
    }
    const selectTag = (tag: string) => {
      const url = new URL(window.location.href);
      if (tag) url.searchParams.set("tag", tag); else url.searchParams.delete("tag");
      if (url.href !== window.location.href) window.history.pushState(null, "", url);
      filterPosts(tag);
    };
    buttons.forEach((button) => button.addEventListener("click", () => selectTag(button.dataset.tag ?? "")));
    document.querySelector("[data-reset-filter]")?.addEventListener("click", () => selectTag(""));
    window.addEventListener("popstate", () => filterPosts(new URLSearchParams(window.location.search).get("tag") ?? ""));
    filterPosts(new URLSearchParams(window.location.search).get("tag") ?? "");
  </script>
</BaseLayout>
