---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostMeta from "../../components/PostMeta.astro";
import { allTags, getVisiblePosts, postUrl, tagSlug } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  return allTags(posts).map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}
const { tag, posts } = Astro.props;
---
<BaseLayout title={`标签：${tag}`} description={`Ash's Blog 中关于“${tag}”的文章。`} canonicalPath={`/tags/${tagSlug(tag)}.html`}>
  <main id="main-content" class="shell">
    <header class="page-header">
      <p class="kicker">标签 / {posts.length} 篇文章</p>
      <h1>{tag}</h1>
      <p>所有带有“{tag}”标签的正式文章。</p>
    </header>
    <section class="home-section" aria-label={`${tag}文章列表`}>
      <div class="post-list">
        {posts.map((post) => (
          <article class="post-row post-row--tag">

            <div>
              <h2><a href={postUrl(post)}>{post.data.title}</a></h2>
              <PostMeta date={post.data.publishedAt} tags={post.data.tags.filter((item) => item !== tag).slice(0, 2)} />
            </div>
            <p>{post.data.description}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
